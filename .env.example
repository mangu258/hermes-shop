# Database (Neon / Supabase / Railway recommended)
DATABASE_URL="postgresql://user:password@host:5432/hermes_shop?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# Optional encryption for payment configs
CONFIG_ENCRYPTION_KEY=""

# Cron job protection
CRON_SECRET=""

# Stripe (leave empty to keep channel disabled)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM="noreply@yourdomain.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
