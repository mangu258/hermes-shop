# Database (Neon / Supabase / Railway)
DATABASE_URL="postgresql://user:password@host:5432/hermes_shop?sslmode=require"

# Auth
JWT_SECRET="change-me-to-a-long-random-string"

# Encrypt payment channel secrets in DB
CONFIG_ENCRYPTION_KEY=""

# Cron (Vercel Cron Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=""
ORDER_TIMEOUT_MINUTES="30"

# Stripe (optional if configured only via admin payment channel)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# App URL (Stripe success/cancel redirects)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

NODE_ENV="development"
